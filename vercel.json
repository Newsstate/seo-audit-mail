{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "functions": {
    "api/audit_run.py": { "maxDuration": 300 },
    "api/audit_start.py": { "maxDuration": 10 },
    "api/audit_poll.py": { "maxDuration": 10 },
    "api/send_email.py": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/audit_start", "dest": "/api/audit_start.py" },
    { "src": "/api/audit_poll",  "dest": "/api/audit_poll.py"  },
    { "src": "/api/audit_run",   "dest": "/api/audit_run.py"   },
    { "src": "/api/send_email",  "dest": "/api/send_email.py"  },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
